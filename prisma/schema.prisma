generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String?
  image          String?
  role           UserRole  @default(MEMBER)
  firmId         String?
  firm           Firm?     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([firmId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Firm ────────────────────────────────────────────────────────

model Firm {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  domain          String?
  phone           String?
  email           String?
  logoUrl         String?
  primaryColor    String   @default("#1e40af")
  secondaryColor  String   @default("#f59e0b")
  timezone        String   @default("America/Chicago")
  plan            FirmPlan @default(STARTER)
  stripeCustomerId String?
  apiKey          String   @unique @default(cuid())
  widgetEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  leads           Lead[]
  conversations   Conversation[]
  intakeConfigs   IntakeConfig[]
  caseTemplates   CaseTemplate[]
  webhooks        Webhook[]
  notifications   NotificationSetting[]
}

enum FirmPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── Intake Configuration ────────────────────────────────────────

model IntakeConfig {
  id              String   @id @default(cuid())
  firmId          String
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name            String   @default("Default")
  isActive        Boolean  @default(true)
  greeting        String   @default("Hi! I'm your virtual legal assistant. How can I help you today?")
  systemPrompt    String   @db.Text
  collectName     Boolean  @default(true)
  collectEmail    Boolean  @default(true)
  collectPhone    Boolean  @default(true)
  collectService  Boolean  @default(true)
  serviceOptions  String[] @default(["Car Accident", "Truck Accident", "Slip and Fall", "Medical Malpractice", "Workers Compensation", "Other"])
  // How much the AI handles: FULL = AI makes sign decision, QUALIFY = AI gathers + scores, COLLECT = AI just collects info
  aiMode          AiMode   @default(QUALIFY)
  qualThreshold   Int      @default(70)  // 0-100, score above this = qualified
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([firmId])
}

enum AiMode {
  COLLECT    // Just collect information, staff decides
  QUALIFY    // AI scores and qualifies, staff confirms
  FULL       // AI qualifies and can initiate signing
}

// ─── Case Templates ──────────────────────────────────────────────

model CaseTemplate {
  id              String   @id @default(cuid())
  firmId          String
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name            String
  caseType        String   // e.g., "auto_accident", "slip_and_fall"
  description     String?
  isActive        Boolean  @default(true)
  questions       Json     // Array of { question, type, required, options?, weight? }
  scoringRules    Json     // Array of { field, condition, score, flag? }
  redFlags        String[] // e.g., ["statute_expired", "no_treatment", "no_insurance"]
  greenFlags      String[] // e.g., ["clear_liability", "severe_injury", "insured_defendant"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads           Lead[]

  @@index([firmId])
}

// ─── Leads ───────────────────────────────────────────────────────

model Lead {
  id              String         @id @default(cuid())
  firmId          String
  firm            Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  templateId      String?
  template        CaseTemplate?  @relation(fields: [templateId], references: [id])

  // Contact info
  name            String
  email           String?
  phone           String?
  preferredContact String?

  // Case details
  caseType        String?
  incidentDate    DateTime?
  incidentLocation String?
  description     String?        @db.Text
  injuryDetails   String?        @db.Text

  // Qualification
  status          LeadStatus     @default(NEW)
  qualScore       Int?           // 0-100
  qualFlags       String[]       // flags from scoring
  qualSummary     String?        @db.Text  // AI-generated case summary
  qualData        Json?          // Structured qualification data

  // Tracking
  source          String?        // "widget", "api", "voice", "manual"
  referrer        String?        // URL where widget was embedded
  ipAddress       String?
  userAgent       String?
  assignedTo      String?        // User ID

  // Documents
  documents       Document[]
  conversations   Conversation[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([firmId])
  @@index([status])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  NOT_QUALIFIED
  PENDING_REVIEW
  SIGNED
  LOST
  ARCHIVED
}

// ─── Conversations ───────────────────────────────────────────────

model Conversation {
  id          String    @id @default(cuid())
  firmId      String
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel     Channel   @default(WEB_CHAT)
  messages    Message[]
  summary     String?   @db.Text
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  @@index([firmId])
  @@index([leadId])
}

enum Channel {
  WEB_CHAT
  SMS
  VOICE
  EMAIL
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── Documents ───────────────────────────────────────────────────

model Document {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String
  type        DocumentType
  url         String
  mimeType    String?
  size        Int?
  status      DocStatus    @default(UPLOADED)
  signedAt    DateTime?
  createdAt   DateTime     @default(now())

  @@index([leadId])
}

enum DocumentType {
  PHOTO
  MEDICAL_RECORD
  POLICE_REPORT
  INSURANCE_DOC
  RETAINER
  ID_DOCUMENT
  OTHER
}

enum DocStatus {
  UPLOADED
  SENT_FOR_SIGNATURE
  VIEWED
  SIGNED
  REJECTED
}

// ─── Webhooks ────────────────────────────────────────────────────

model Webhook {
  id        String        @id @default(cuid())
  firmId    String
  firm      Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  url       String
  events    String[]      // ["lead.qualified", "lead.new", "conversation.ended"]
  secret    String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([firmId])
}

// ─── Notification Settings ───────────────────────────────────────

model NotificationSetting {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  event     String   // "lead.qualified", "lead.new", etc.
  channel   String   // "email", "sms", "webhook"
  target    String   // email address, phone, or webhook ID
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([firmId])
}
